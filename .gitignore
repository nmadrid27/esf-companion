.DS_Store
Thumbs.db
*.swp
*~

# Python
__pycache__/
*.py[cod]
*$py.class
.vscode/
.idea/
node_modules/
.env
.env.local
.obsidian/
.smart-env/

# Syncthing temp files
.syncthing.*.tmp

# ESF session buffer (ephemeral, not versioned)
.session-buffer.md

# Dev session tracking (local only)
session_state.md
session_log.md

# Cowork plugin binary — distributed via GitHub releases, not tracked in repo
platforms/esf-companion.plugin

# Landing page — local only, not part of public repo
landing/

# Launch and outreach drafts — private working files (newsletter pitches,
# site reviews, OER submission, LinkedIn drafts). Kept on disk for reference
# but not committed to the public repo.
launch/

# Local Claude Code settings (machine-specific overrides)
.claude/settings.local.json

# Local Claude Code notes: documents the gitignored local-only working folders
# (ibl-mentor/, landing/, launch/). Loaded from disk for local sessions and
# synced across machines via Syncthing; not part of the public repo.
CLAUDE.md

# Other AI tool local state
.qwen/

# Temporary files (commit messages, logs)
*.tmp
.commit-msg.tmp

# Dated planning / design / handoff artifacts in docs/ (working files,
# not user-facing documentation). User-facing docs in docs/ use kebab-case
# names without a date prefix.
docs/20[0-9][0-9]-*.md
docs/esf-project-history.md

# Defense Pack outputs (generated; never committed)
esf/*/defense-packs/

# ESF demo sandbox (generated at runtime by /esf-demo). The template source
# lives in platforms/cowork/templates/demo-project/ and stays tracked so users
# get the demo. Only the generated sandbox and its runtime companion-state.md
# are local-only. Root-anchored so the tracked template and the
# companion-state.md fixtures under test/ and sample/ are unaffected.
/demo/
/companion-state.md

# Claude Code agent worktrees — temporary worktrees created by parallel
# subagent dispatch (isolation=worktree). Each worktree is its own git
# checkout pinned to a stable commit; the parent repo does not track them.
.claude/worktrees/

# ibl.ai mentor setup: local-only. Files for deploying the ESF Companion as a
# no-code mentor on ibl.ai (system prompt, proactive message, guided prompts,
# dataset copies, setup guide). Never part of the public repo.
ibl-mentor/
docs/BRIEFING.md
logs/
