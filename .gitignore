.DS_Store
Thumbs.db
*.swp
*~

# Python
__pycache__/
*.py[cod]
*$py.class
.vscode/
.idea/
node_modules/
.env
.env.local
.obsidian/
.smart-env/

# Syncthing temp files
.syncthing.*.tmp

# ESF session buffer (ephemeral, not versioned)
.session-buffer.md

# Dev session tracking (local only)
session_state.md
session_log.md

# Cowork plugin binary — distributed via GitHub releases, not tracked in repo
platforms/esf-companion.plugin

# Landing page — local only, not part of public repo
landing/

# Launch and outreach drafts — private working files (newsletter pitches,
# site reviews, OER submission, LinkedIn drafts). Kept on disk for reference
# but not committed to the public repo.
launch/

# Local Claude Code settings (machine-specific overrides)
.claude/settings.local.json

# Other AI tool local state
.qwen/

# Temporary files (commit messages, logs)
*.tmp
.commit-msg.tmp

# Dated planning / design / handoff artifacts in docs/ (working files,
# not user-facing documentation). User-facing docs in docs/ use kebab-case
# names without a date prefix.
docs/20[0-9][0-9]-*.md
docs/esf-project-history.md

# Defense Pack outputs (generated; never committed)
esf/*/defense-packs/
