{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/esf-session-status.sh\"",
            "timeout": 5,
            "statusMessage": "Loading ESF Companion..."
          }
        ]
      }
    ]
  }
}
